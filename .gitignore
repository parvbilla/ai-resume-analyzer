# ==============================================================================
# PROJECT-SPECIFIC
# ==============================================================================

# Frozen dependency snapshot (generated, not source)
requirements-lock.txt

# Local development overrides
local_settings.py
local_config.py

# Analysis exports (future feature)
exports/
reports/

